<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX 打包 profile（单项目打包，GenerateAppxPackageOnBuild=true 时自动切回打包模式）。

  双轨共用：
  - 旁加载（sideload）：默认签名，证书路径/密码由 CI 命令行传入
    （-p:PackageCertificateKeyFile=... -p:PackageCertificatePassword=...）
  - Microsoft Store：CI 用 -p:AppxPackageSigningEnabled=false 覆盖为未签名包
    （Store 认证通过后会用微软证书重新签名，无需自签名）

  版本号由 CI 传入 -p:AppxPackageVersion=1.2.3.0（覆盖 manifest 写死的 1.0.0.0）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- publish profile 在 csproj 主体求值后才导入，csproj 里依赖 GenerateAppxPackageOnBuild
         的条件属性（WindowsPackageType=None 等）来不及生效，这里必须显式覆盖为打包模式 -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <!-- 时间戳：ServerUrl 非空才会加时间戳（证书过期后包仍可安装），DigestAlgorithm 必须显式指定（否则 signtool 报 APPX1204）。
         AppxPackageSigningTimestampEnabled 在该 targets 中未被消费，真正生效的是 ServerUrl -->
    <AppxPackageSigningTimestampServerUrl>http://timestamp.digicert.com</AppxPackageSigningTimestampServerUrl>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
  </PropertyGroup>
</Project>
