<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MemeManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 默认以非打包方式运行：用 Bootstrap 初始化 Windows App SDK（避免 DeploymentManager 崩溃）。
         仅在显式生成 MSIX 包（GenerateAppxPackageOnBuild=true）时回到打包模式。 -->
    <WindowsPackageType Condition="'$(GenerateAppxPackageOnBuild)' != 'true'">None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize Condition="'$(GenerateAppxPackageOnBuild)' != 'true'">true</WindowsAppSdkBootstrapInitialize>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 体积 + 启动速度：WinUI 与 trimming / AOT 均不兼容，关闭以避免运行时崩溃 -->
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>


    <!-- 保留栈追踪与全球化，确保 WinUI / COM 互操作正常运行 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <StackTraceSupport>true</StackTraceSupport>

    <!-- 必须保持开启：NativeMethods 的 LibraryImport 源生成器生成的互操作代码（LibraryImports.g.cs）
         本身使用 unsafe，关闭会报 CS0227（实测 22 处）；项目源码中无手写 unsafe 块 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 版本信息：CI 通过 -p:AppVersion=vX.Y.Z 传入；本地构建未传则用编译时间戳 + dev -->
    <InformationalVersion Condition="'$(AppVersion)' != ''">$(AppVersion)</InformationalVersion>
    <InformationalVersion Condition="'$(AppVersion)' == ''">$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss')) dev build</InformationalVersion>

    <!-- 文件版本/程序集版本（exe 详细信息里的"文件版本"行）：由 AppVersion(vX.Y.Z) 派生并补第 4 段，
         如 v1.12.11 -> 1.12.11.0。
         注意：MSIX 包版本与此无关（写死在 Package.appxmanifest，由 CI 替换，见 release.yml）。 -->
    <_AppVersionNumeric Condition="'$(AppVersion)' != ''">$(AppVersion.TrimStart('v'))</_AppVersionNumeric>
    <FileVersion Condition="'$(_AppVersionNumeric)' != ''">$(_AppVersionNumeric).0</FileVersion>
    <FileVersion Condition="'$(AppVersion)' == ''">$([System.DateTime]::Now.ToString('yyyy.MM.dd.HHmm'))</FileVersion>
    <AssemblyVersion Condition="'$(_AppVersionNumeric)' != ''">$(_AppVersionNumeric).0</AssemblyVersion>
    <AssemblyVersion Condition="'$(AppVersion)' == ''">$([System.DateTime]::Now.ToString('yyyy.MM.dd.HHmm'))</AssemblyVersion>

    
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- .editorconfig 在仓库根目录，显式 include 使其在 Solution Explorer 可见。
       注意：EditorConfig 按目录自动发现，此 include 不影响其生效，仅为可见性。 -->
  <ItemGroup>
    <None Include="..\.editorconfig" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
    <PackageReference Include="WinUI3Localizer" Version="2.3.0" />
    <PackageReference Include="XBindLeakFix" Version="1.0.0" />
  </ItemGroup>

  <!-- WinUI3Localizer 从输出目录的 Strings 文件夹读取 resw（非 PRI 内嵌），需复制到输出 -->
  <ItemGroup>
    <Content Include="Strings\**\*.resw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    发布后删除 Windows App SDK 带入的冗余 AI/ML 运行时（OnnxRuntime / DirectML / Windows.AI.*）。
    本项目仅用 WinUI，未引用任何 AI/ML API，已验证删除后 exe 正常运行。
    针对 $(PublishDir)（dotnet publish -o 的实际输出目录）删除，确保命中最终发布产物；
    同时清理 $(OutDir) 覆盖本地 VS/普通 Build 场景。
    TreatErrorsAsWarnings 确保某些构建未生成这些文件时也不报错。
  -->
  <Target Name="RemoveUnusedAiDlls" AfterTargets="Publish">
    <ItemGroup>
      <_UselessDlls Include="$(PublishDir)onnxruntime.dll" />
      <_UselessDlls Include="$(PublishDir)DirectML.dll" />
      <_UselessDlls Include="$(PublishDir)System.Numerics.Tensors.dll" />
      <_UselessDlls Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
      <_UselessDlls Include="$(PublishDir)Microsoft.Windows.AI.MachineLearning.dll" />
      <_UselessDlls Include="$(PublishDir)Microsoft.Windows.AI.*.dll" />
      <_UselessDlls Include="$(PublishDir)WebView2Loader.dll" />
      <_UselessDlls Include="$(PublishDir)Microsoft.Web.WebView2.*.dll" />
      <_UselessDlls Include="$(PublishDir)Microsoft.Security.Authentication.OAuth.Projection.dll" />
    </ItemGroup>
    <Delete Files="@(_UselessDlls)" TreatErrorsAsWarnings="true" />
  </Target>

</Project>