<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MemeManager.MiniPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MemeManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    xmlns:viewmodels="using:MemeManager.ViewModels"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 悬浮条圆角背景 + 阴影 -->
        <CornerRadius x:Key="MiniBarRadius">10</CornerRadius>
    </Page.Resources>

    <Grid AllowDrop="True"
          DragOver="Grid_DragOver"
          Drop="Grid_Drop"
          DragLeave="Grid_DragLeave">

        <!-- 半透明圆角悬浮条，自带关闭/设置按钮（无系统标题栏） -->
        <Border Margin="6"
                x:Name="BarBorder"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                CornerRadius="{StaticResource MiniBarRadius}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                PointerPressed="BarBorder_PointerPressed"
                PointerMoved="BarBorder_PointerMoved"
                PointerReleased="BarBorder_PointerReleased"
                PointerCanceled="BarBorder_PointerReleased">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="6,2">
                <!-- 分类下拉：Mini 模式单一当前分类，拖入/点选都基于它 -->
                <ComboBox x:Name="CategoryCombo"
                          Grid.Column="0"
                          MinWidth="100"
                          MaxWidth="160"
                          SelectionChanged="CategoryCombo_SelectionChanged">
                    <ToolTipService.ToolTip>
                        <ToolTip l:Uids.Uid="Mini_Category"/>
                    </ToolTipService.ToolTip>
                </ComboBox>

                <!-- 表情 Picker：弹出缩略图网格，点选即回贴前台应用 -->
                <Button x:Name="PickerButton"
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        l:Uids.Uid="Mini_Picker"
                        Click="PickerButton_Click"/>

                <!-- 设置 -->
                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Click="SettingsButton_Click">
                    <SymbolIcon Symbol="Setting"/>
                    <ToolTipService.ToolTip>
                        <ToolTip l:Uids.Uid="Mini_Settings"/>
                    </ToolTipService.ToolTip>
                </Button>

                <!-- 关闭 = 隐藏到托盘（与主窗口关闭行为一致） -->
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        Margin="4,0,0,0"
                        Click="CloseButton_Click">
                    <SymbolIcon Symbol="Cancel"/>
                    <ToolTipService.ToolTip>
                        <ToolTip l:Uids.Uid="Mini_Close"/>
                    </ToolTipService.ToolTip>
                </Button>
            </Grid>
        </Border>

        <!-- 拖入提示遮罩：拖文件到悬浮条上时显示 -->
        <Border x:Name="DropHint"
                Margin="6"
                CornerRadius="{StaticResource MiniBarRadius}"
                Background="{ThemeResource SystemAccentColor}"
                Opacity="0.25"
                Visibility="Collapsed"/>

        <!-- 表情选择面板：Popup 可超出窗口边界（ShouldConstrainToRootBounds=False），
             点 Picker 按钮时定位到悬浮条上方显示，点选即回贴前台应用。 -->
        <Popup x:Name="PickerPopup"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="False">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Grid Width="360" Height="300">
                    <ScrollViewer>
                        <ItemsRepeater x:Name="PickerRepeater"
                                       ItemsSource="{x:Bind _pickerMemes, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill"
                                                  MaximumRowsOrColumns="4"
                                                  MinItemWidth="80"
                                                  MinItemHeight="80"
                                                  Orientation="Horizontal"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:MemeViewModel">
                                    <Grid Margin="3"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          CornerRadius="6"
                                          Padding="2"
                                          Tapped="PickerItem_Tapped">
                                        <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <TextBlock x:Name="PickerEmptyHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               Visibility="Collapsed"
                               l:Uids.Uid="Mini_PickerEmpty"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Page>
